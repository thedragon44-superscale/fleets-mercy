// schemas/space_pirates.fbs
namespace SpacePirates;

// --- ENUMS ---

enum ResourceType : ubyte {
  None = 0,
  Metal = 1,
  Ore = 2,
  Isotope = 3,
  PlasmaGas = 4,
  GravitonCore = 5
}

enum ClientActionType : ubyte {
  None = 0,
  JoinSeat = 1,
  LeaveSeat = 2,
  SetMultiplier = 3,
  DeployUnit = 4
}

enum EnvObjectType : ubyte {
  Unknown = 0,
  MajorWorld = 1,
  MineralPlanetoid = 2,
  GasGiant = 3,
  NebulaField = 4,
  SingularityRift = 5,
  Moon = 6,
  AsteroidBelt = 7,
  AsteroidCluster = 8,
  Comet = 9
}

enum EnvComponentKind : ubyte {
  SolidRock = 0,
  ResourceNode = 1,
  SolidCore = 2,
  CaveMouth = 3,
  CraterNode = 4,
  GasCore = 5,
  GasDeep = 6,
  GasOuter = 7,
  NebulaBlob = 8,
  RiftCore = 9,
  RiftField = 10,
  CometCore = 11
}

// --- SHARED STRUCTS ---

struct Vec2 {
  x: float;
  y: float;
}

struct Shields {
  front: float;
  rear: float;
  port: float;
  starboard: float;
}

struct Hull {
  front: float;
  rear: float;
  port: float;
  starboard: float;
}

// --- DOWNSTREAM: SERVER STATE (60Hz Binary Broadcast) ---

table SPUnit {
  id: string;
  unit_type: string;          // e.g. "viper_interceptor", "mining_barge", "flagship"
  owner_id: string;           // "house" or "seat-0".."seat-3"
  seat_index: byte = -1;      // -1 = House (red glow), 0..3 = Player seat color
  is_house: bool;

  pos: Vec2;
  vel: Vec2;
  angle: float;
  shields: Shields;
  hull: Hull;

  is_firing: bool;
  is_squad_leader: bool;
  squad_id: int;
  ai_state: string;

  // Player Combatant Telemetry
  current_ammo: int;
  max_ammo: int;
  bet_multiplier: ubyte;      // 1, 2, 5, 10, 25

  // House Harvester & Bounty Telemetry
  resource_type: ResourceType;
  cargo_ratio: float;         // 0.0 -> 1.0 (drives visual cargo ring)
  current_bounty_cents: long; // Live 1x bounty in cents
  is_stealthed: bool;         // True inside Nebula or Gas Giant Deep Atmosphere
}

table SPProjectile {
  id: string;
  owner_id: string;
  seat_index: byte = -1;
  is_house: bool;
  proj_type: string;          // "laser", "railgun", "torpedo", "cryo"
  pos: Vec2;
  vel: Vec2;
  bet_multiplier: ubyte;
}

table SPAsteroidNode {
  id: uint;
  cluster_id: uint;
  pos: Vec2;
  vel: Vec2;
  radius: float;
  is_node: bool;              // false = tactical cover rock, true = unlimited resource node
  resource_type: ResourceType;
}

table SPEnvComponent {
  id: uint;
  kind: EnvComponentKind;
  pos: Vec2;
  vel: Vec2;
  radius: float;
  inner_radius: float;
  is_node: bool;
  resource_type: ResourceType;
  color_hex: string;
}

table SPEnvObject {
  id: uint;
  blueprint_id: int;
  object_type: EnvObjectType;
  pos: Vec2;
  vel: Vec2;
  angle: float;
  bounding_radius: float;
  parent_object_id: uint;
  orbit_radius: float;
  components: [SPEnvComponent];
}

table SPCryoCloud {
  id: uint;
  owner_id: string;
  seat_index: byte = -1;
  pos: Vec2;
  radius: float;
  remaining_ticks: ushort;
  max_ticks: ushort;
}

table SPSeatState {
  seat_index: byte;           // 0 = NW, 1 = NE, 2 = SW, 3 = SE
  occupied: bool;
  player_id: int;             // Matches PostgreSQL players.id
  username: string;
  balance_cents: long;        // Synced with PostgreSQL wallets.balance_cents
  active_multiplier: ubyte;   // 1, 2, 5, 10, 25
  active_unit_count: ushort;
}

table SPPayoutEvent {
  event_id: ulong;
  seat_index: byte;
  unit_type: string;
  pos: Vec2;
  payout_cents: long;         // Final multiplied payout in cents
  multiplier: ubyte;
  was_boss: bool;
}

table SPServerState {
  tick: ulong;
  table_id: string;
  arena_width: float;
  arena_height: float;

  units: [SPUnit];
  projectiles: [SPProjectile];
  asteroids: [SPAsteroidNode];
  cryo_clouds: [SPCryoCloud];
  seats: [SPSeatState];
  payout_events: [SPPayoutEvent];

  // Table-Wide Boss Meter & Escape Timer
  boss_meter_current: uint;
  boss_meter_threshold: uint;
  boss_active: bool;
  boss_escape_ticks_remaining: uint;

  // Universal Environmental Objects (all 9 celestial archetypes)
  env_objects: [SPEnvObject];
}

// --- UPSTREAM: CLIENT ACTIONS (Binary WebSocket Messages) ---

table SPClientAction {
  action: ClientActionType;
  player_id: int;             // Real PostgreSQL players.id (used on JoinSeat)
  seat_index: byte = -1;      // Optional preferred corner (0..3) or -1 for auto-assign
  multiplier: ubyte;          // Used with SetMultiplier (1, 2, 5, 10, 25)
  unit_type: string;          // Used with DeployUnit ("viper_interceptor", etc.)
}

root_type SPServerState;
