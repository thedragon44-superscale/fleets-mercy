namespace SpaceTactics;

// --- SHARED STRUCTS ---

struct Vector2D {
  x: float;
  y: float;
}

struct Shields {
  front: float;
  rear: float;
  port: float;
  starboard: float;
}

struct Hull {
  front: float;
  rear: float;
  port: float;
  starboard: float;
}

// --- DOWNSTREAM: SERVER STATE (60 FPS Broadcast) ---

table FleetUnit {
  id: string;
  type: string;
  owner_id: string;
  pos: Vector2D;
  angle: float;
  shields: Shields;
  hull: Hull;
  is_destroyed: bool;
  is_squad_leader: bool;
  is_firing: bool;
  battalion_id: int;
  squad_id: int;
}

table Projectile {
  id: string;
  owner_id: string;
  type: string;
  pos: Vector2D;
}

table ServerState {
  tick: ulong;
  units: [FleetUnit];
  projectiles: [Projectile];
  map_width: float;
  map_height: float;
}

// --- UPSTREAM: CLIENT INPUT & INSPECTOR TUNING PAYLOADS ---

table UnitConfigUpdate {
  speed: double;
  dps: double;
  max_cooldown: int;
  vision_range: int;
  max_thermal_capacity: double;
}

table BehaviorConfigUpdate {
  ai_default_state: string;
  aggro_range: double;
  squad_cohesion_leash_range: double;
  retreat_morale_threshold: double;
  radar_immunity_active: bool;
  requires_anchor_drone: bool;
}

table SandboxCountPair {
  unit_type: string;
  count: int;
}

table UnitGroupingPayload {
  unit_id: string;
  battalion_id: int;
  squad_id: int;
  is_squad_leader: bool;
}

table ClientInput {
  // 1. Movement & Flight Controls (WASD, Aim, Firing)
  w: bool;
  s: bool;
  a: bool;
  d: bool;
  angle: float;
  is_firing: bool;
  controlled_unit_id: string;
  reset: bool;

  // 2. Sandbox Spawning & Unit Counts
  deploy: string;
  sandbox_spawn: string;
  sandbox_remove: string;
  spawn_x: double;
  spawn_y: double;
  sandbox_counts: [SandboxCountPair];

  // 3. Inspector Tab: Live Stat Tuning Overrides
  template_override_type: string;
  template_override_config: UnitConfigUpdate;

  // 4. Inspector Tab: Live Behavior Overrides
  behavior_override_type: string;
  behavior_override_config: BehaviorConfigUpdate;

  // 5. Fleet Grouping / Docking Bay Squad Assignments
  unit_grouping: UnitGroupingPayload;
}

root_type ServerState;
